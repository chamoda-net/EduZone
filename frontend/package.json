{
  "name": "eduzone-frontend",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @eduzone/web",
    "dev:admin": "npm run dev -w @eduzone/admin",
    "build": "npm run build -w @eduzone/web -w @eduzone/admin",
    "lint": "npm run lint -w @eduzone/web -w @eduzone/admin",
    "typecheck": "npm run typecheck -w @eduzone/web -w @eduzone/admin",
    "api-client": "npm run generate -w @eduzone/api-client",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
