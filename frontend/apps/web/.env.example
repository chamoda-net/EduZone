# Backend base URL as seen from the Next.js server (not the browser).
API_URL=http://localhost:8000

# The API's WEB_SERVER_KEY: lets this server tell the API each visitor's address, so sign-in and SMS limits count per
# visitor. Required in production; optional locally. Never NEXT_PUBLIC, and never given to the admin app.
# WEB_SERVER_KEY=
# How many of our own proxies (load balancer, CDN) stand in front of this server. Default 1. The outermost one must
# set or extend X-Forwarded-For.
# WEB_PROXY_HOPS=1

# Same client id as the API's GOOGLE_CLIENT_ID; unset hides the Google button.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# The main site's host without port (the API's BASE_DOMAIN). Tenant sites are <slug>.<BASE_DOMAIN>.
BASE_DOMAIN=localhost
