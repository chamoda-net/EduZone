# Backend base URL as seen from the Next.js server (not the browser).
API_URL=http://localhost:8000

# Same client id as the API's GOOGLE_CLIENT_ID; unset hides the Google button.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# The main site's host without port (the API's BASE_DOMAIN). Tenant sites are <slug>.<BASE_DOMAIN>.
BASE_DOMAIN=localhost
