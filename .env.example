# Copy to .env and fill in. Never commit .env.
# Used by docker-compose.yml (database passwords) and by the backend (connection URLs).

ENVIRONMENT=local
BASE_DOMAIN=eduzone.lk

# --- Postgres (docker-compose) ------------------------------------------------
# eduzone_owner: owns the schema, runs Alembic migrations only.
POSTGRES_PASSWORD=change-me-owner
# Runtime roles, created by docker/postgres/init-roles.sh on first start.
EDUZONE_APP_PASSWORD=change-me-app
EDUZONE_ADMIN_PASSWORD=change-me-admin

# --- Backend connection URLs ----------------------------------------------------
# Tenant-facing requests (subject to RLS).
DATABASE_URL=postgresql+asyncpg://eduzone_app:change-me-app@localhost:5432/eduzone
# Platform admin endpoints and background jobs (BYPASSRLS).
ADMIN_DATABASE_URL=postgresql+asyncpg://eduzone_admin:change-me-admin@localhost:5432/eduzone
# Alembic only.
MIGRATION_DATABASE_URL=postgresql+psycopg://eduzone_owner:change-me-owner@localhost:5432/eduzone

# --- Redis ----------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
