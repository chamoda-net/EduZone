# Copy to .env and fill in. Never commit .env.
# Used by docker-compose.yml (database passwords) and by the backend (connection URLs).

ENVIRONMENT=local
# Tenants are served on <slug>.BASE_DOMAIN. For local dev, set BASE_DOMAIN=localhost and
# open http://<slug>.localhost:8000 (browsers resolve *.localhost to 127.0.0.1).
BASE_DOMAIN=eduzone.lk

# --- Postgres (docker-compose) ------------------------------------------------
# eduzone_owner: owns the schema, runs Alembic migrations only.
POSTGRES_PASSWORD=change-me-owner
# Runtime roles, created by docker/postgres/init-roles.sh on first start.
EDUZONE_APP_PASSWORD=change-me-app
EDUZONE_ADMIN_PASSWORD=change-me-admin

# --- Backend connection URLs ----------------------------------------------------
# Tenant-facing requests (subject to RLS).
DATABASE_URL=postgresql+asyncpg://eduzone_app:change-me-app@localhost:5432/eduzone
# Platform admin endpoints and background jobs (BYPASSRLS).
ADMIN_DATABASE_URL=postgresql+asyncpg://eduzone_admin:change-me-admin@localhost:5432/eduzone
# Alembic only.
MIGRATION_DATABASE_URL=postgresql+psycopg://eduzone_owner:change-me-owner@localhost:5432/eduzone

# --- Redis ----------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Auth -----------------------------------------------------------------------
# At least 32 characters each. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-for-jwt-signing
OTP_SECRET=change-me-to-a-different-long-random-string-otp
# 'console' prints login codes to the backend log (local dev only).
SMS_PROVIDER=console

# --- Bunny (optional locally; uploads return "not set up" without these) ---------
# One Stream library per organization: library id -> its API key and embed token key.
# Then set tenants.bunny_library_id for the organization.
# BUNNY_STREAM_LIBRARIES={"123456": {"api_key": "...", "token_key": "..."}}
# Shared secret appended to the Stream webhook URL: /api/v1/webhooks/bunny/stream?token=...
# BUNNY_WEBHOOK_TOKEN=
# PDFs: storage zone + the pull zone (with token authentication) that serves it.
# BUNNY_STORAGE_ZONE=
# BUNNY_STORAGE_HOST=storage.bunnycdn.com
# BUNNY_STORAGE_API_KEY=
# BUNNY_CDN_HOST=
# BUNNY_CDN_TOKEN_KEY=
